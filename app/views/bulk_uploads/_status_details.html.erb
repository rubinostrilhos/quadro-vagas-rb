<div class="space-y-4">
  <div class="relative w-full bg-gray-200 rounded-full h-6 overflow-hidden">
    <div class="bg-blue-500 h-full transition-all duration-300" style="width: <%= ((processed.to_f / total_lines) * 100).round %>%"></div>
  </div>
  <p class="text-center text-sm text-gray-700">
    Processado: <span id="processed" class="font-semibold"><%= processed %></span> / <span class="font-semibold"><%= total_lines %></span>
  </p>

  <div class="grid grid-cols-2 gap-4 text-sm">
    <div class="bg-green-100 text-green-700 p-2 rounded" id="successful">
      <strong>Sucesso:</strong> <%= successful %>
    </div>
    <div class="bg-red-100 text-red-700 p-2 rounded">
      <strong>Erros:</strong> <%= errors %>
    </div>
  </div>

  <% if errors_details.any? %>
    <div class="bg-red-50 p-4 rounded shadow-sm">
      <h3 class="text-red-700 font-semibold">Lista de Erros</h3>
      <ul class="mt-2 space-y-2 text-sm text-red-600">
        <% errors_details.each do |e| %>
          <li class="border-l-4 border-red-400 pl-2"><%= e %></li>
        <% end %>
      </ul>
    </div>
  <% end %>
</div>
