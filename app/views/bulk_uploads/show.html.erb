<div class="max-w-2xl mx-auto bg-white p-6 rounded-lg shadow-md">
  <h1 class="text-2xl font-semibold text-gray-800 mb-4">Status do Upload</h1>
  <%= turbo_stream_from "bulk_uploads" %>

  <div id="upload_status_<%= @bulk_upload.id %>" class="mt-4 w-[450px]">
    <%= render partial: "status_details", locals: { total_lines: @bulk_upload.total_lines, processed: @processed, remaining: @remaining, errors_details: @errors_details, successful: @successful, errors: @errors, total: @processed + @remaining } %>
  </div>
</div>
