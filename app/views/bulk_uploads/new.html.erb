<div class="max-w-lg mx-auto bg-white p-6 rounded-lg shadow-md">
  <h1 class="text-2xl font-semibold text-gray-800 mb-6"><%= t('.title') %></h1>

  <%= form_with url: bulk_uploads_path, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :file, t('.upload_file'), class: "block mb-2 text-sm font-medium text-gray-700" %>
      <%= f.file_field :file, class: 'w-full text-sm text-gray-700 border border-gray-300 rounded-md file:mr-4 file:py-2 file:px-4 file:border-none
            file:bg-blue-500 file:text-white hover:file:bg-blue-600 cursor-pointer transition-all duration-300' %>
    </div>

    <%= f.submit 'Upload', class: 'w-full bg-blue-600 text-white py-2 px-4 rounded-md font-medium hover:bg-blue-700 transition-all duration-300' %>
  <% end %>
</div>
